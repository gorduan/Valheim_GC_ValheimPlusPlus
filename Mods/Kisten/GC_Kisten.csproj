    <AssemblyName>GC_Kisten</AssemblyName>
    <RootNamespace>GC.ValheimPlusPlus.ModKisten</RootNamespace>
    <Product>GC_Kisten</Product>
    <Version>1.5.1</Version>
    <GcPaket>ValheimPlusPlus</GcPaket>
